# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# .env is gitignored — it's your local, personal overrides. This file
# (.env.example) is the committed source of truth for every tunable and its
# default. `make run` loads .env automatically if it exists; unset values
# fall back to the defaults baked into internal/config/config.go.
#
# Docker Compose (Phase 3+) reads this same file for variable substitution
# and per-service env_file: blocks — one file, both run modes.

# Listen address for the HTTP server.
API_ADDR=:8080

# How long graceful shutdown waits for in-flight requests to drain.
API_SHUTDOWN_TIMEOUT=10s

# GET /slow sleeps a random duration in [min,max] ms. ?max_ms= overrides max.
API_SLOW_MIN_MS=50
API_SLOW_MAX_MS=2000

# GET /error fails with this probability, clamped to [0,1]. ?rate= overrides.
API_ERROR_RATE=0.3

# Phase 6: protects the failure-simulation control plane (/admin/chaos, /cpu,
# /leak). Unset = endpoints open (a startup warning is logged).
API_ADMIN_TOKEN=

# Phase 8: backing systems.
#   API_DATABASE_URL — source of truth; the API exits if this is unreachable.
#     Compose default is the service hostname; for bare `make run` use localhost
#     (and `docker compose up -d postgres` first).
#   API_REDIS_ADDR   — products cache; Redis down degrades to DB reads.
#   API_KAFKA_BROKERS — best-effort order events; empty disables publishing.
API_DATABASE_URL=postgres://lab:lab@postgres:5432/lab?sslmode=disable
API_REDIS_ADDR=redis:6379
API_KAFKA_BROKERS=kafka:9092

# Phase 8: cmd/consumer (order-processors group).
CONSUMER_KAFKA_BROKERS=kafka:9092
CONSUMER_DELAY_MS=50
